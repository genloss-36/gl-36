{
  "name": "gl-36",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genloss-36/gl-36.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "deployments",
    "tools/*",
    "docs",
    "collections/*"
  ],
  "scripts": {
    "build": "npm run build -w @gl36/sdk",
    "test": "npm test -w @gl36/sdk && npm test -w genloss",
    "typecheck": "npm run typecheck -w @gl36/sdk",
    "check": "npm run check -w gl36-docs && npm run check -w genloss",
    "docs": "npm run dev -w gl36-docs",
    "genloss": "npm run dev -w genloss"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "4.156.2"
  }
}
