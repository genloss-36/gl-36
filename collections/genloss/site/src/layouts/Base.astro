---
import "../styles/global.css";
import archivo from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import { t, type Lang } from "../i18n/strings";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const pages = { en: base, zh: `${base}zh/` };
const title = t(lang, "meta.title");
const description = t(lang, "meta.description");
const image = abs(`${base}${lang === "zh" ? "og-zh.png" : "og.png"}`);
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(pages[lang])} />
    <link rel="alternate" hreflang="en" href={abs(pages.en)} />
    <link rel="alternate" hreflang="zh-CN" href={abs(pages.zh)} />
    <link rel="alternate" hreflang="x-default" href={abs(pages.en)} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GENLOSS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(pages[lang])} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "zh" ? "en_US" : "zh_CN"} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(lang, "meta.ogAlt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={t(lang, "meta.ogAlt")} />
  </head>
  <body>
    <slot />
  </body>
</html>
