{
  "name": "genloss",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "GENLOSS, the first collection on GL-36: generator, mint site and deployment script.",
  "scripts": {
    "predev": "node site/scripts/sync-generator.mjs",
    "dev": "cd site && astro dev",
    "prebuild": "node site/scripts/sync-generator.mjs",
    "build": "astro build --root site",
    "deploy": "wrangler deploy",
    "preview": "astro preview --root site",
    "check": "astro check --root site",
    "test": "node --conditions=source --test test/*.test.ts",
    "generator": "node generator/check.mjs",
    "seed": "node --conditions=source scripts/seed.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@gl36/deployments": "*",
    "@gl36/sdk": "*",
    "@nanostores/react": "2.0.1",
    "@solana/kit": "8.5.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "astro": "7.4.4",
    "nanostores": "1.5.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@gl36/devnet": "*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
