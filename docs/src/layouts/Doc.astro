---
import { getCollection, type CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import AgentPrompt from "../components/AgentPrompt.astro";
import { NAV, ORDER, groupOf, docHref } from "../data/nav";
import "../styles/prose.css";
import "../styles/code.css";

interface Props {
  entry: CollectionEntry<"docs">;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const all = new Map((await getCollection("docs")).map((e) => [e.id, e]));
const label = (id: string) => all.get(id)?.data.nav ?? all.get(id)?.data.title ?? id;
const i = ORDER.indexOf(entry.id);
const prev = i > 0 ? ORDER[i - 1] : undefined;
const next = i >= 0 && i < ORDER.length - 1 ? ORDER[i + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const group = groupOf(entry.id);
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const schema = [
  {
    "@type": "TechArticle",
    headline: entry.data.title,
    description: entry.data.description,
    url: abs(docHref(entry.id)),
    inLanguage: "en",
    about: "GL-36, an NFT standard for Solana",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Docs", item: abs("/docs/") },
      { "@type": "ListItem", position: 2, name: entry.data.title, item: abs(docHref(entry.id)) },
    ],
  },
];
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  current={group === "Reference" ? "reference" : "docs"}
  menu
  ogType="article"
  schema={schema}
>
  <div class="doc wide">
    <nav class="side" id="sidebar" aria-label="Documentation">
      <div>
        {
          NAV.map((g) => (
            <div class="group">
              <p class="label">{g.label}</p>
              <ul>
                {g.items.map((id) => (
                  <li>
                    <a href={docHref(id)} aria-current={id === entry.id ? "page" : undefined}>
                      {label(id)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="group">
          <p class="label">Tools</p>
          <ul>
            <li><a href="/inspector/">Inspector</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <main id="main" class="main">
      <header class="head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/docs/">Docs</a><span aria-hidden="true">/</span><span>{group}</span>
        </nav>
        <h1 class="title page-title">{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
        {entry.data.agent && <AgentPrompt />}
      </header>
      <article class="prose">
        <slot />
      </article>
      <nav class="pager" aria-label="Pagination">
        {
          prev ? (
            <a class="prev" href={docHref(prev)}>
              <span class="label">Previous</span>
              <span class="pt">{label(prev)}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="next" href={docHref(next)}>
              <span class="label">Next</span>
              <span class="pt">{label(next)}</span>
            </a>
          )
        }
      </nav>
    </main>

    <div class="toc">
      {
        toc.length > 1 && (
          <nav aria-label="On this page">
            <p class="label" aria-hidden="true">On this page</p>
            <span class="toc-mark" aria-hidden="true" />
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>
</Base>

<script>
  const links = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc a")).map((a) => [a.hash.slice(1), a]),
  );
  if (links.size) {
    const seen = new Set<string>();
    const mark = document.querySelector<HTMLElement>(".toc-mark");
    const pick = () => {
      const first = Array.from(links.keys()).find((id) => seen.has(id));
      links.forEach((a, id) => a.toggleAttribute("data-active", id === first));
      const a = first ? links.get(first) : undefined;
      if (!mark) return;
      const placing = !mark.hasAttribute("data-on");
      if (a) {
        if (placing) mark.style.transition = "none";
        mark.style.transform = `translateY(${a.offsetTop}px)`;
        mark.style.height = `${a.offsetHeight}px`;
        if (placing) {
          void mark.offsetHeight;
          mark.style.transition = "";
        }
      }
      mark.toggleAttribute("data-on", !!a);
    };
    const io = new IntersectionObserver(
      (es) => {
        es.forEach((e) => (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id)));
        pick();
      },
      { rootMargin: "-80px 0px -60% 0px" },
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }

  document.querySelectorAll<HTMLHeadingElement>(".prose h2[id], .prose h3[id]").forEach((h) => {
    const a = document.createElement("a");
    a.className = "anchor";
    a.href = `#${h.id}`;
    a.textContent = "#";
    a.setAttribute("aria-hidden", "true");
    a.tabIndex = -1;
    h.prepend(a);
  });

  const wraps = document.querySelectorAll<HTMLElement>(".prose .table-wrap");
  const fit = () =>
    wraps.forEach((w) => {
      const over = w.scrollWidth > w.clientWidth + 1;
      if (over === w.hasAttribute("tabindex")) return;
      if (over) {
        let h: Element | null = w.previousElementSibling;
        while (h && !/^H[23]$/.test(h.tagName)) h = h.previousElementSibling;
        w.tabIndex = 0;
        w.setAttribute("role", "group");
        w.setAttribute("aria-label", `${h?.textContent?.replace(/^#/, "") ?? "Table"}, scrolls sideways`);
      } else {
        w.removeAttribute("tabindex");
        w.removeAttribute("role");
        w.removeAttribute("aria-label");
      }
    });
  fit();
  new ResizeObserver(fit).observe(document.querySelector(".prose")!);

  document.querySelectorAll(".prose code").forEach((c) => c.setAttribute("translate", "no"));

  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "copy press";
    b.textContent = "Copy";
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? pre.innerText);
        b.textContent = "Copied";
      } catch {
        b.textContent = "Select and copy";
      }
      setTimeout(() => (b.textContent = "Copy"), 1600);
    });
    const wrap = document.createElement("div");
    wrap.className = "code";
    pre.replaceWith(wrap);
    wrap.append(pre, b);
  });

</script>

<style>
  .doc {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px) 220px;
    justify-content: center;
    gap: 64px;
    align-items: start;
  }
  .side,
  .toc {
    position: sticky;
    top: var(--header-h);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding: 40px 0 48px;
    scrollbar-width: none;
  }
  .side::-webkit-scrollbar,
  .toc::-webkit-scrollbar {
    display: none;
  }
  .group + .group {
    margin-top: 28px;
  }
  .side ul,
  .toc ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }
  .side li a {
    display: block;
    padding: 5px 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--fg-2);
    transition: color 0.2s var(--ease);
  }
  .side li a:hover {
    color: var(--fg);
  }
  .side li a[aria-current="page"] {
    color: var(--fg);
    font-weight: 600;
  }

  .main {
    min-width: 0;
    max-width: 760px;
    padding: 56px 0 0;
  }
  .head {
    padding-bottom: 40px;
    margin-bottom: 8px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--fg-3);
  }
  .crumbs a {
    color: var(--fg-2);
    transition: color 0.2s var(--ease);
  }
  .crumbs a:hover {
    color: var(--fg);
  }
  .page-title {
    margin: 14px 0 20px;
    font-size: clamp(40px, 5.4vw, 72px);
    overflow-wrap: anywhere;
  }

  .toc nav {
    position: relative;
  }
  .toc-mark {
    position: absolute;
    top: 0;
    left: -14px;
    width: 2px;
    border-radius: 2px;
    background: var(--fg);
    opacity: 0;
    transition:
      transform var(--spring-dur) var(--spring),
      height var(--spring-dur) var(--spring),
      opacity 0.2s var(--ease);
  }
  .toc-mark[data-on] {
    opacity: 1;
  }
  .toc li a {
    display: block;
    padding: 4px 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--fg-3);
    transition: color 0.2s var(--ease);
  }
  .toc li.d3 a {
    padding-left: 12px;
  }
  .toc li a:hover,
  .toc li a[data-active] {
    color: var(--fg);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 96px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: var(--bg-elev);
    transition: background-color 0.2s var(--ease);
  }
  .pager a:hover {
    background: var(--bg-elev-2);
  }
  .pager .next {
    text-align: right;
    grid-column: 2;
  }
  .pt {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  @media (min-width: 1025px) {
    .side {
      view-transition-name: sidebar;
    }
  }
  @media (max-width: 1240px) {
    .doc {
      grid-template-columns: 220px minmax(0, 760px);
      gap: 56px;
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 1024px) {
    .doc {
      display: block;
    }
    .side {
      position: fixed;
      inset: var(--header-h) 0 0;
      z-index: 40;
      max-height: none;
      padding: 24px var(--gutter) 64px;
      overscroll-behavior: contain;
      background: var(--bg);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.25s var(--ease),
        transform var(--spring-dur) var(--spring),
        visibility 0s linear 0.25s;
    }
    :global(body[data-menu-open]) {
      overflow: hidden;
    }
    :global(body[data-menu-open]) .side {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.25s var(--ease),
        transform var(--spring-dur) var(--spring);
    }
    .side li a {
      padding: 8px 0;
      font-size: 17px;
    }
    .main {
      padding-top: 40px;
      margin-inline: auto;
    }
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      grid-column: 1;
    }
  }
</style>
