---
import { RENT, ACCOUNT_OVERHEAD } from "../lib/config";

interface Props {
  supply?: number;
}
const { supply = 10_000 } = Astro.props;
---

<div class="calc" data-calc data-supply={supply} data-overhead={ACCOUNT_OVERHEAD}>
  <div class="controls">
    <label class="supply">
      <span class="label">Collection size</span>
      <output class="n" data-n>{supply.toLocaleString("en-US")}</output>
      <input type="range" min="0" max="1000" step="1" data-range aria-label="Collection size" />
    </label>
    <div class="rate" role="group" aria-label="Rent rate">
      <span class="label">Rent rate</span>
      <button class="press" type="button" aria-pressed="true" data-rate={RENT.now}>
        <i aria-hidden="true"></i>Today<span>{RENT.now.toLocaleString("en-US")}&nbsp;lamports per byte</span>
      </button>
      <button class="press" type="button" aria-pressed="false" data-rate={RENT.afterCuts}>
        <i aria-hidden="true"></i>After SIMD-0437<span>{RENT.afterCuts}&nbsp;lamports per byte</span>
      </button>
    </div>
  </div>

  <div class="sides">
    <div class="side gl">
      <span class="label">GL-36</span>
      <p class="cost"><span data-gl-sol></span>&nbsp;SOL</p>
      <p class="bytes" data-gl-bytes></p>
      <div class="dots" data-gl-dots aria-hidden="true"></div>
    </div>
    <div class="side classic">
      <span class="label">Classic NFT</span>
      <p class="cost"><span data-cl-sol></span>&nbsp;SOL</p>
      <p class="bytes" data-cl-bytes></p>
      <div class="dots" data-cl-dots aria-hidden="true"></div>
    </div>
  </div>

  <p class="saving" aria-live="polite">
    <span data-ratio></span>× less rent. <span class="muted">You keep <span data-saved></span>&nbsp;SOL.</span>
  </p>
</div>

<script>
  const CLASSIC = 82 + 165 + 679 + 282;
  const HEADER = 224;
  const SLOT = 36;
  const MIN = 100;
  const MAX = 65_535;
  const toSupply = (p: number) => {
    if (p >= 1000) return MAX;
    const raw = MIN * Math.pow(MAX / MIN, p / 1000);
    const step = raw < 1_000 ? 10 : raw < 10_000 ? 100 : 500;
    return Math.round(raw / step) * step;
  };
  const toPos = (n: number) => Math.round((Math.log(n / MIN) / Math.log(MAX / MIN)) * 1000);
  const fmt = (lamports: number) => {
    const v = lamports / 1e9;
    return v.toLocaleString("en-US", { maximumFractionDigits: v < 1 ? 4 : v < 100 ? 2 : 0 });
  };

  document.querySelectorAll<HTMLElement>("[data-calc]").forEach((root) => {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const range = $<HTMLInputElement>("[data-range]");
    const overhead = Number(root.dataset.overhead);
    let rate = Number($<HTMLButtonElement>("[aria-pressed=true]").dataset.rate);
    let n = Number(root.dataset.supply);
    range.value = String(toPos(n));

    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let shown = { gl: 0, cl: 0 };
    let raf = 0;

    const dots = (el: HTMLElement, count: number) => {
      if (el.childElementCount === count) return;
      el.replaceChildren(...Array.from({ length: count }, () => document.createElement("i")));
    };

    const paint = (gl: number, cl: number) => {
      shown = { gl, cl };
      $("[data-gl-sol]").textContent = fmt(gl);
      $("[data-cl-sol]").textContent = fmt(cl);
      $("[data-ratio]").textContent = (cl / gl).toFixed(1);
      $("[data-saved]").textContent = fmt(cl - gl);
    };

    const render = (animate = false) => {
      const glBytes = overhead + HEADER + n * SLOT;
      const clBytes = n * (CLASSIC + 4 * overhead);
      const gl = glBytes * rate;
      const cl = clBytes * rate;
      $("[data-n]").textContent = n.toLocaleString("en-US");
      range.setAttribute("aria-valuetext", `${n.toLocaleString("en-US")} tokens`);
      $("[data-gl-bytes]").textContent = `${glBytes.toLocaleString("en-US")} bytes in 1 account`;
      $("[data-cl-bytes]").textContent = `${clBytes.toLocaleString("en-US")} bytes in ${(n * 4).toLocaleString("en-US")} accounts`;
      dots($<HTMLElement>("[data-gl-dots]"), 1);
      dots($<HTMLElement>("[data-cl-dots]"), Math.round(cl / gl));
      cancelAnimationFrame(raf);
      if (!animate || still || !shown.cl) return paint(gl, cl);
      const from = shown;
      const w = (2 * Math.PI) / 0.4;
      const t0 = performance.now();
      const step = (now: number) => {
        const t = (now - t0) / 1000;
        const x = t >= 0.7 ? 1 : 1 - (1 + w * t) * Math.exp(-w * t);
        paint(from.gl + (gl - from.gl) * x, from.cl + (cl - from.cl) * x);
        if (x < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    range.addEventListener("input", () => {
      n = toSupply(Number(range.value));
      render();
    });
    root.querySelectorAll<HTMLButtonElement>("[data-rate]").forEach((b) =>
      b.addEventListener("click", () => {
        rate = Number(b.dataset.rate);
        root.querySelectorAll("[data-rate]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        render(true);
      }),
    );
    render();
  });
</script>

<style>
  .calc {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
  }
  .controls {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px 64px;
    flex-wrap: wrap;
  }
  .supply {
    display: grid;
    gap: 10px;
    flex: 1 1 320px;
    max-width: 520px;
  }
  .n {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 28px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--line-strong);
    border-radius: 2px;
  }
  input[type="range"]::-moz-range-track {
    height: 2px;
    background: var(--line-strong);
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -10px;
    border-radius: 30%;
    background: var(--fg);
  }
  input[type="range"]::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border: 0;
    border-radius: 30%;
    background: var(--fg);
  }

  .rate {
    display: grid;
    justify-items: start;
    gap: 6px;
  }
  .rate .label {
    margin-bottom: 4px;
  }
  .rate button {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 2px 0;
    border: 0;
    background: none;
    color: var(--fg-3);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }
  .rate button i {
    align-self: center;
    width: 8px;
    height: 8px;
    border-radius: 30%;
    background: var(--field-ink);
    transition: background-color 0.2s var(--ease);
  }
  .rate button span {
    font-size: 13px;
    font-weight: 400;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .rate button:hover,
  .rate button[aria-pressed="true"] {
    color: var(--fg);
  }
  .rate button[aria-pressed="true"] i {
    background: var(--fg);
  }
  .rate button[aria-pressed="true"] span {
    color: var(--fg-2);
  }

  .sides {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px clamp(32px, 6vw, 96px);
  }
  .side {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .cost {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .classic .cost {
    color: var(--fg-2);
  }
  .bytes {
    margin: 0;
    font-size: 13px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .dots {
    display: grid;
    grid-template-columns: repeat(auto-fill, 12px);
    gap: 4px;
    max-width: calc(24 * 12px + 23 * 4px);
    margin-top: 16px;
  }
  .dots :global(i) {
    width: 12px;
    height: 12px;
    border-radius: 30%;
    background: var(--field-ink);
  }
  .gl .dots :global(i) {
    background: var(--fg);
  }
  .saving {
    margin: 0;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .muted {
    color: var(--fg-2);
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .sides {
      grid-template-columns: 1fr;
    }
    .dots {
      grid-template-columns: repeat(auto-fill, 10px);
      max-width: none;
    }
    .dots :global(i) {
      width: 10px;
      height: 10px;
    }
  }
</style>
