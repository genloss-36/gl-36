---
---

<dialog class="search" data-search aria-label="Search the docs">
  <div class="box">
    <div class="field">
      <svg class="glass" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <circle cx="7.75" cy="7.75" r="5.75" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="m12 12 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <label class="sr-only" for="search-input">Search the docs</label>
      <input
        id="search-input"
        type="search"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        placeholder="Search the docs, e.g. withdraw_excess…"
      />
      <kbd class="esc">Esc</kbd>
      <button class="cancel press" type="button" data-search-close>Cancel</button>
    </div>
    <p class="head" data-search-head>Suggested</p>
    <ul class="results" id="search-results" role="listbox" aria-label="Results" data-search-results></ul>
    <p class="sr-only" role="status" data-search-status></p>
    <p class="hints" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> to move <kbd>↵</kbd> to open <kbd>Esc</kbd> to close</p>
  </div>
</dialog>

<script>
  interface Rec {
    p: string;
    g: string;
    h: string;
    u: string;
    x: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>("[data-search]")!;
  const input = dialog.querySelector<HTMLInputElement>("#search-input")!;
  const list = dialog.querySelector<HTMLUListElement>("[data-search-results]")!;
  const head = dialog.querySelector<HTMLElement>("[data-search-head]")!;
  const status = dialog.querySelector<HTMLElement>("[data-search-status]")!;
  const SUGGESTED = ["Quickstart", "Rent and cost", "Collection account", "Instructions", "Errors"];
  const LIMIT = 12;

  let index: Rec[] | null = null;
  let loading: Promise<void> | null = null;
  let failed = false;
  let hits: Rec[] = [];
  let active = 0;

  const load = () =>
    (loading ??= fetch("/search.json")
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      })
      .then((d: Rec[]) => {
        index = d;
        failed = false;
      })
      .catch(() => {
        failed = true;
        loading = null;
      }));

  const startsWord = (hay: string, t: string) => {
    for (let i = hay.indexOf(t); i >= 0; i = hay.indexOf(t, i + 1)) {
      if (i === 0 || !/[a-z0-9]/.test(hay[i - 1])) return true;
    }
    return false;
  };
  const count = (hay: string, t: string) => {
    let n = 0;
    for (let i = hay.indexOf(t); i >= 0 && n < 3; i = hay.indexOf(t, i + 1)) n++;
    return n;
  };

  function score(r: Rec, terms: string[], phrase: string): number {
    const p = r.p.toLowerCase();
    const h = r.h.toLowerCase();
    const x = r.x.toLowerCase();
    let s = 0;
    for (const t of terms) {
      const inP = p.includes(t);
      const inH = h.includes(t);
      const inX = x.includes(t);
      if (!inP && !inH && !inX) return 0;
      if (inH) s += startsWord(h, t) ? 8 : 5;
      if (inP) s += startsWord(p, t) ? (r.h ? 2 : 9) : 1;
      if (inX) s += count(x, t);
    }
    if (terms.length > 1 && (h.includes(phrase) || x.includes(phrase))) s += 6;
    return s;
  }

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const mark = (s: string, terms: string[]) => {
    const safe = esc(s);
    if (!terms.length) return safe;
    const re = new RegExp(`(${terms.map((t) => esc(t).replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})`, "gi");
    return safe.replace(re, "<mark>$1</mark>");
  };
  function snippet(x: string, terms: string[]): string {
    const low = x.toLowerCase();
    const at = Math.min(...terms.map((t) => low.indexOf(t)).filter((i) => i >= 0), Infinity);
    if (!isFinite(at) || at < 60) return x.length > 170 ? `${x.slice(0, 170).replace(/\s\S*$/, "")}…` : x;
    const from = x.lastIndexOf(" ", at - 50) + 1;
    const to = x.indexOf(" ", at + 110);
    return `…${x.slice(from, to < 0 ? undefined : to)}${to < 0 ? "" : "…"}`;
  }

  function render(terms: string[]) {
    list.replaceChildren(
      ...hits.map((r, i) => {
        const li = document.createElement("li");
        li.setAttribute("role", "none");
        const a = document.createElement("a");
        a.id = `search-hit-${i}`;
        a.href = r.u;
        a.tabIndex = -1;
        a.setAttribute("role", "option");
        a.setAttribute("aria-selected", String(i === active));
        a.innerHTML =
          `<span class="where">${esc(r.g)} / ${esc(r.p)}</span>` +
          `<span class="what">${mark(r.h || r.p, terms)}</span>` +
          (terms.length ? `<span class="snip">${mark(snippet(r.x, terms), terms)}</span>` : "");
        li.append(a);
        li.addEventListener("pointermove", () => setActive(i, false));
        a.addEventListener("click", () => dialog.close());
        return li;
      }),
    );
    setActive(0, false);
  }

  function setActive(i: number, scroll = true) {
    if (!hits.length) {
      input.removeAttribute("aria-activedescendant");
      return;
    }
    active = (i + hits.length) % hits.length;
    list.querySelectorAll("[role=option]").forEach((li, k) => li.setAttribute("aria-selected", String(k === active)));
    const opt = list.querySelectorAll<HTMLElement>("[role=option]")[active];
    input.setAttribute("aria-activedescendant", opt?.id ?? "");
    if (scroll) opt?.scrollIntoView({ block: "nearest" });
  }

  async function run() {
    const q = input.value.trim().toLowerCase();
    if (!index) {
      head.textContent = "Loading the index…";
      list.replaceChildren();
      await load();
      if (!index) {
        head.textContent = "Search couldn’t load. Check your connection, then close and open it again.";
        status.textContent = head.textContent;
        return;
      }
    }
    const terms = q.split(/\s+/).filter(Boolean);
    if (!terms.length) {
      hits = SUGGESTED.map((p) => index!.find((r) => r.p === p && !r.h)).filter((r): r is Rec => !!r);
      head.textContent = "Suggested";
      render([]);
      status.textContent = "";
      return;
    }
    hits = index
      .map((r) => ({ r, s: score(r, terms, q) }))
      .filter((h) => h.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, LIMIT)
      .map((h) => h.r);
    head.textContent = hits.length ? "Results" : `Nothing found for “${input.value.trim()}”. Try an instruction like mint, or an error code like 0x6.`;
    status.textContent = hits.length ? `${hits.length} result${hits.length === 1 ? "" : "s"}` : head.textContent;
    render(terms);
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    if (failed) loading = null;
    run();
  }

  input.addEventListener("input", () => run());
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      setActive(active + (e.key === "ArrowDown" ? 1 : -1));
    } else if (e.key === "Enter" && hits[active]) {
      e.preventDefault();
      dialog.close();
      location.href = hits[active].u;
    }
  });
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close());

  document.querySelectorAll("[data-search-open]").forEach((b) => b.addEventListener("click", open));
  window.addEventListener(
    "keydown",
    (e) => {
      const typing = e.target instanceof HTMLElement && e.target.closest("input, textarea, select, [contenteditable]");
      const k = e.code === "KeyK" || e.key.toLowerCase() === "k";
      if (k && (e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey) {
        e.preventDefault();
        dialog.open ? dialog.close() : open();
      } else if ((e.key === "/" || (e.code === "Slash" && !e.shiftKey)) && !e.metaKey && !e.ctrlKey && !typing && !dialog.open) {
        e.preventDefault();
        open();
      }
    },
    { capture: true },
  );

  document.querySelectorAll("[data-search-open]").forEach((b) => b.addEventListener("pointerenter", () => load(), { once: true }));
</script>

<style>
  .search {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100dvh - 120px));
    margin: 12vh auto 0;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: var(--bg-elev);
    color: var(--fg);
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.5);
    overflow: hidden;
  }
  .search[open] {
    display: flex;
    animation: pop var(--spring-dur) var(--spring);
  }
  .search::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: fade 0.2s var(--ease);
  }
  :global(:root[data-theme="light"]) .search::backdrop {
    background: rgb(0 0 0 / 0.25);
  }
  :global(:root[data-theme="light"]) .search {
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.18);
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .box {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    border-bottom: 1px solid var(--line);
  }
  .glass {
    flex: none;
    color: var(--fg-3);
  }
  input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 18px;
    letter-spacing: -0.02em;
    outline: none;
    appearance: none;
  }
  input::placeholder {
    color: var(--fg-3);
  }
  input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--fg-2);
  }
  .cancel {
    display: none;
    border: 0;
    background: none;
    padding: 8px 0;
    font-size: 15px;
    color: var(--fg);
    cursor: pointer;
  }

  .head {
    margin: 0;
    padding: 14px 20px 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-2);
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 0 8px 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .results :global(li a) {
    display: grid;
    gap: 3px;
    padding: 10px 12px;
    border-radius: 10px;
    transition: background-color 0.12s var(--ease);
  }
  .results :global(a[aria-selected="true"]) {
    background: var(--bg-elev-2);
  }
  .results :global(.where) {
    font-size: 12px;
    color: var(--fg-3);
  }
  .results :global(.what) {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.016em;
  }
  .results :global(.snip) {
    font-size: 14px;
    line-height: 1.45;
    color: var(--fg-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .results :global(mark) {
    background: none;
    color: var(--fg);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .hints {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 10px 20px;
    font-size: 12px;
    color: var(--fg-3);
  }
  .hints kbd {
    min-width: 20px;
    height: 20px;
    font-size: 11px;
  }
  .hints kbd + kbd {
    margin-left: -2px;
  }

  @media (max-width: 640px), (pointer: coarse) {
    .search {
      width: 100%;
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
      border: 0;
      border-radius: 0;
    }
    .esc,
    .hints {
      display: none;
    }
    .cancel {
      display: block;
    }
    .search[open] {
      animation: fade 0.2s var(--ease);
    }
  }
</style>
