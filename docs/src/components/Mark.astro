---
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <rect x="0" y="0" width="16" height="16" rx="3.6" fill="currentColor"></rect>
  <rect x="18.34" y="18.34" width="5.66" height="5.66" rx="1.4" fill="currentColor"></rect>
</svg>
