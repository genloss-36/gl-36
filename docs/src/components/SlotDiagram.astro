---
interface Props {
  account?: boolean;
}
const { account = true } = Astro.props;

let seed = 0x2436;
const rnd = () => {
  seed ^= seed << 13;
  seed ^= seed >>> 17;
  seed ^= seed << 5;
  return (seed >>> 0) & 0xff;
};
const bytes = (n: number) => Array.from({ length: n }, rnd);
const size = (v: number) => (0.16 + 0.7 * Math.sqrt(v / 255)).toFixed(3);

const owner = bytes(32);
const price = [0x90, 0xd0, 0x03, 0x00];

const header = [1, 1, 253, 0, 0x88, 0x13, 3, 0, 200, 0, 0, 0, ...bytes(4), 0x80, 0x96, 0x98, 0, 0, 0, 0, 0];
header.push(...bytes(64), ...new Array(96).fill(0), ...bytes(32), ...new Array(8).fill(0));
const others = [bytes(32), bytes(32)];
const rows: { bytes: number[]; label?: string; short?: string; lit?: boolean; free?: boolean }[] = [];
for (let r = 0; r < 7; r++) rows.push({ bytes: header.slice(r * 36, r * 36 + 36), label: r === 0 ? "header, 224 bytes" : undefined, short: r === 0 ? "header" : undefined });
rows.push({ bytes: [...owner, ...price], label: "slot 0", lit: true });
rows.push({ bytes: [...others[0], 0, 0, 0, 0], label: "slot 1" });
rows.push({ bytes: [...others[1], 0x20, 0xa1, 0x07, 0], label: "slot 2" });
rows.push({ bytes: new Array(36).fill(0), label: "the next mint adds a row", short: "next mint", free: true });
---

<figure class="slot-fig" data-slot-fig>
  <div class="slot" aria-hidden="true">
    {owner.map((v, i) => <span class="cell" style={`--s:${size(v)};--i:${i}`}><i /></span>)}
    <span class="gap"></span>
    {price.map((v, i) => <span class="cell price" style={`--s:${size(v)};--i:${i + 33}`}><i /></span>)}
    <span class="tick t0">0</span>
    <span class="tick t31">31</span>
    <span class="tick t32">32</span>
    <span class="tick t35">35</span>
  </div>
  <div class="legend">
    <p><code>owner</code> 32 bytes, the holder’s public key</p>
    <p class="right"><code>price</code> 4 bytes, the ask in units of 1,000 lamports; 0 is not listed</p>
  </div>

  {
    account && (
      <div class="acct" aria-hidden="true">
        <div class="field">
          {rows.map((row) => (
            <div class:list={["row", { lit: row.lit, free: row.free }]}>
              <span class="dots">
                {row.bytes.map((v) => (
                  <span class="cell" style={`--s:${row.free ? "0.12" : size(v)}`}>
                    <i />
                  </span>
                ))}
              </span>
              {row.label && (
                <span class="lab">
                  <span class="long">{row.label}</span>
                  <span class="short">{row.short ?? row.label}</span>
                </span>
              )}
            </div>
          ))}
        </div>
        <p class="formula mono">account length = 224 + minted × 36</p>
      </div>
    )
  }
  <figcaption class="sr-only">
    A slot is 36 bytes: bytes 0 to 31 hold the owner, bytes 32 to 35 the listing price. The collection account is a
    224-byte header followed by one 36-byte row per minted token.
  </figcaption>
</figure>

<script>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.setAttribute("data-in", "");
          io.unobserve(e.target);
        }),
      { threshold: 0.4 },
    );
    document.querySelectorAll<HTMLElement>("[data-slot-fig]").forEach((f) => {
      if (f.getBoundingClientRect().top < innerHeight * 0.6) return;
      f.setAttribute("data-motion", "");
      io.observe(f);
    });
  }
</script>

<style>
  .slot-fig {
    margin: 0;
  }
  .slot {
    display: grid;
    grid-template-columns: repeat(32, minmax(0, 1fr)) 0.6fr repeat(4, minmax(0, 1fr));
    align-items: center;
    row-gap: 10px;
    max-width: 1240px;
  }
  .cell {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }
  .cell i {
    width: calc(var(--s) * 100%);
    height: calc(var(--s) * 100%);
    border-radius: 30%;
    background: var(--fg);
  }
  .slot .cell.price i {
    background: var(--fg-2);
  }
  .tick {
    grid-row: 2;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .t0 {
    grid-column: 1 / 5;
    padding-left: 2px;
  }
  .t31 {
    grid-column: 29 / 33;
    justify-self: end;
  }
  .t32 {
    grid-column: 34 / 36;
    padding-left: 2px;
  }
  .t35 {
    grid-column: 36 / 38;
    justify-self: end;
  }
  .legend {
    display: flex;
    justify-content: space-between;
    gap: 16px 48px;
    flex-wrap: wrap;
    max-width: 1240px;
    margin-top: 20px;
  }
  .legend p {
    margin: 0;
    max-width: 30em;
    font-size: 15px;
    color: var(--fg-2);
  }
  .legend .right {
    text-align: right;
  }
  .legend code {
    margin-right: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
    background: none;
    padding: 0;
  }

  .acct {
    margin-top: clamp(48px, 6vw, 72px);
  }
  .field {
    display: grid;
    gap: 3px;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .dots {
    display: grid;
    grid-template-columns: repeat(36, 11px);
    gap: 3px;
    flex: none;
  }
  .dots i {
    background: var(--field-ink);
  }
  .row.lit .dots i {
    background: var(--fg);
  }
  .row.free .dots i {
    opacity: 0.5;
  }
  .lab {
    font-size: 13px;
    color: var(--fg-3);
    white-space: nowrap;
  }
  .row.lit .lab {
    color: var(--fg);
  }
  .lab .short {
    display: none;
  }
  .formula {
    margin: 18px 0 0;
    font-size: 13px;
    color: var(--fg-3);
  }

  .slot-fig[data-motion] .slot .cell i {
    transform: scale(0);
  }
  .slot-fig[data-motion] .row {
    opacity: 0;
    transform: translateY(6px);
  }
  .slot-fig[data-in] .slot .cell i {
    transform: none;
    transition: transform var(--spring-dur) var(--spring) calc(var(--i) * 14ms);
  }
  .slot-fig[data-in] .row {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.3s var(--ease) 560ms,
      transform var(--spring-dur) var(--spring) 560ms;
  }

  @media (max-width: 720px) {
    .slot {
      grid-template-columns: repeat(32, minmax(0, 1fr)) 1.2fr repeat(4, minmax(0, 1fr));
    }
    .tick {
      font-size: 10px;
    }
    .legend .right {
      text-align: left;
    }
    .dots {
      grid-template-columns: repeat(36, 5px);
      gap: 2px;
    }
    .row {
      gap: 10px;
    }
    .lab {
      font-size: 12px;
    }
    .lab .long {
      display: none;
    }
    .lab .short {
      display: inline;
    }
  }
</style>
